// MELEH ONE web app on Cloudflare Workers + Static Assets.
// Deployed by .github/workflows/deploy-web.yml on push to meleh/main. Manual: `bun run deploy:workers` in apps/web.
{
  "name": "meleh-one-web",
  "main": "build/worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    // Files are served as-is; every extensionless route (including "/") reaches the Worker,
    // which returns index.html with route-specific meta tags.
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "routes": [{ "pattern": "app.meleh.us", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "production",
  },
  "observability": {
    "enabled": true,
  },
}
