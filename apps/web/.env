# MELEH ONE: no third-party keys in the repo. Real keys go in .env.override (git-ignored);
# all backend traffic goes through *.meleh.us (see packages/api/src/clients/base/entryGatewayUrls.ts).
APP_ID=web
ALCHEMY_API_KEY=""
