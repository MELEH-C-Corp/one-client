BLOCKAID_PROXY_URL="https://api.meleh.us/infra/blockaid"
INFURA_KEY=""
JUPITER_PROXY_URL="https://api-dev.meleh.us/jupiter"
PRIVY_APP_ID="privy_app_id"
PRIVY_CLIENT_ID="privy_client_id"
QUICKNODE_ENDPOINT_NAME=""
QUICKNODE_ENDPOINT_TOKEN=""
SENTRY_ENABLED="false"
STATSIG_API_KEY=""
STATSIG_PROXY_URL="https://gating.interface.gateway.meleh.us/v1/statsig-proxy"
TRADING_API_KEY=""
UNISWAP_API_KEY=""
UNISWAP_GATEWAY_DNS="https://interface.gateway.meleh.us/v2"
WALLET_CONNECT_PROJECT_ID="walletconnect_project_id"
